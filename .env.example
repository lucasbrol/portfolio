# Chave do Google AI Studio (https://aistudio.google.com/apikey). Obrigatória em produção.
GEMINI_API_KEY=

# Opcionais
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# MIN_SCORE=0.45                 # similaridade mínima para considerar a pergunta "sobre o Lucas"
# RATE_LIMIT_PER_MIN=10
# GITHUB_TOKEN=                  # aumenta o limite da API do GitHub no build
# GITHUB_EXCLUDE=repo1,repo2     # repositórios que não devem aparecer
